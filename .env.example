# Copy to .env. This file is sourced as shell code: use trusted values only.
MODEL_ID=Qwen/Qwen3-8B
MODEL_REVISION=main
SERVED_MODEL_NAME=qwen3-8b
HOST=127.0.0.1
PORT=8000
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_UTILIZATION=0.40
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
# Replace locally; never commit an actual API key or HF token.
VLLM_API_KEY=
# Optional, only for gated/private models after accepting their terms:
# HF_TOKEN=
# HF_HOME=/persistent/path/huggingface
